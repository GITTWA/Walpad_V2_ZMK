#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // LIVELLO 0: Default (Tasti Alfanumerici base)
        default_layer {
            bindings = <
                &kp Q   &kp W   &kp E   &kp R   &kp T
                &kp A   &kp S   &kp D   &kp F   &kp G
                &kp Z   &kp X   &kp C   &kp V   &kp B
                        &mo 1   &mo 2   &kp SPACE
            >;
        };

        // LIVELLO 1: Navigazione e Numeri (Tenendo premuto il 1° tasto pollice)
        nav_layer {
            bindings = <
                &kp N1  &kp N2    &kp N3    &kp N4     &kp N5
                &kp TAB &kp LEFT  &kp DOWN  &kp UP     &kp RIGHT
                &none   &kp HOME  &kp PG_DN &kp PG_UP  &kp END
                        &trans    &trans    &kp ENTER
            >;
        };

        // LIVELLO 2: Gestione Bluetooth e Funzioni (Tenendo premuto il 2° tasto pollice)
        fn_layer {
            bindings = <
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_CLR  &none  &bootloader
                &kp F1        &kp F2        &kp F3      &kp F4 &kp F5
                &kp F6        &kp F7        &kp F8      &kp F9 &kp F10
                              &trans        &trans      &trans
            >;
        };
    };
};